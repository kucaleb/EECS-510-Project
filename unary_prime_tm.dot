digraph UnaryPrimeChecker {
    # --- Global Settings ---
    compound=true; # Allows edges between clusters
    rankdir=LR;
    node [shape = circle, fontname = "Helvetica", style=filled, fillcolor=white];
    edge [fontname = "Helvetica", fontsize = 10];
    bgcolor = "#f8f9fa"; # Light gray background

    # --- Start & Halt Nodes ---
    start [shape = point, width=0];
    HALT_ACCEPT [shape = doublecircle, label = "ACCEPT", fillcolor = "#d4edda", color = "#155724"];
    HALT_REJECT [shape = doublecircle, label = "REJECT", fillcolor = "#f8d7da", color = "#721c24"];

    start -> q_start;

    # ==========================================
    # SECTION 1: BASE CASES (Check 1 & 2)
    # ==========================================
    subgraph cluster_base {
        label = "Base Case Check";
        style = dashed;
        color = "#6c757d";
        bgcolor = "#e9ecef";

        q_start -> q_check_1 [label = "1/1, R"];
        
        q_check_1 -> HALT_REJECT [label = "_/_, L"]; # Reject "1"
        q_check_1 -> q_check_2 [label = "1/1, R"];
        
        q_check_2 -> q_found_2 [label = "_/_, L"];
        q_check_2 -> q_reset_head [label = "1/1, R"]; # >2, go to Setup

        q_found_2 -> HALT_ACCEPT [label = "1/1, L"]; # Accept "2"
    }

    # ==========================================
    # SECTION 2: SETUP WORKSPACE (n -> n # m)
    # ==========================================
    subgraph cluster_setup {
        label = "Setup Workspace";
        style = dashed;
        color = "#007bff";
        bgcolor = "#e7f1ff";

        q_reset_head -> q_reset_head [label = "1/1, L"];
        q_reset_head -> q_init_start [label = "_/_, R"];

        q_init_start -> q_seek_end [label = "1/$, R"];
        q_seek_end -> q_seek_end [label = "1/1, R"];
        q_seek_end -> q_prep_m [label = "_/#, R"];
        
        q_prep_m -> q_rewind [label = "_/1, L"];
        
        q_rewind -> q_rewind [label = "1/1, L\n#/#, L"];
        q_rewind -> q_copy_loop [label = "$/1, R"];

        # Copy Loop Logic
        q_copy_loop -> q_carry [label = "1/$, R"];
        q_copy_loop -> q_seek_m_end [label = "#/#, R"];

        q_carry -> q_carry [label = "1/1, R\n#/#, R"];
        q_carry -> q_return [label = "_/1, L"];

        q_return -> q_return [label = "1/1, L\n#/#, L"];
        q_return -> q_copy_loop [label = "$/1, R"];

        # Formatting (m = n-1)
        q_seek_m_end -> q_seek_m_end [label = "1/1, R"];
        q_seek_m_end -> q_sub_1 [label = "_/_, L"];
        q_sub_1 -> q_find_sep [label = "1/_, L"];

        q_find_sep -> q_find_sep [label = "1/1, L"];
        q_find_sep -> q_place_pct [label = "#/#, R"];
        q_place_pct -> q_reset_n [label = "1/%, L"];
        
        q_reset_n -> q_reset_n [label = "1/1, L\n#/#, L"];
        q_reset_n -> q_mark_dol [label = "_/_, R"];
        q_mark_dol -> q_mod_entry [label = "1/$, N"];
    }

    # ==========================================
    # SECTION 3: MODULO LOOP (n % m)
    # ==========================================
    subgraph cluster_mod {
        label = "Modulo Operation";
        style = dashed;
        color = "#28a745";
        bgcolor = "#e8f5e9";

        q_mod_entry -> q_mod_loop [label = "$/1, R"];
        
        q_mod_loop -> q_move_pct [label = "1/$, R"];
        q_mod_loop -> q_check_rem [label = "#/#, R"]; # End of N

        q_move_pct -> q_move_pct [label = "1/1, R\n#/#, R"];
        q_move_pct -> q_chk_m_end [label = "%/1, R"];

        q_chk_m_end -> q_wrap_pct [label = "_/_, L"]; # Wrap Around
        q_chk_m_end -> q_return_n [label = "1/%, L"]; # Continue

        q_wrap_pct -> q_wrap_pct [label = "1/1, L"];
        q_wrap_pct -> q_reset_pct [label = "#/#, R"];
        q_reset_pct -> q_return_n [label = "1/%, L"];

        q_return_n -> q_return_n [label = "1/1, L\n%/%, L\n#/#, L"];
        q_return_n -> q_mod_loop [label = "$/1, R"];
    }

    # ==========================================
    # SECTION 4: CHECK REMAINDER
    # ==========================================
    subgraph cluster_check {
        label = "Check Remainder";
        style = dashed;
        color = "#17a2b8";
        bgcolor = "#e0f7fa";

        q_check_rem -> q_verify [label = "%/1, R"];
        q_check_rem -> q_check_rem [label = "1/1, R"];
        
        q_verify -> q_deny_clean [label = "_/_, L"]; # Divisible (Fail)
        q_verify -> q_clean_mod [label = "1/%, L"];  # Not Divisible (Pass)

        q_clean_mod -> q_clean_mod [label = "1/1, L\n%/1, L"];
        q_clean_mod -> q_fix_pct [label = "#/#, R"];
        
        q_fix_pct -> q_fix_return [label = "1/%, L"];
        q_fix_return -> q_fix_return [label = "1/1, L\n#/#, L"];
        q_fix_return -> q_fix_dol [label = "_/_, R"];
        q_fix_dol -> q_sub_entry [label = "1/$, N"];
    }

    # ==========================================
    # SECTION 5: SUBTRACT (m = m - 1)
    # ==========================================
    subgraph cluster_sub {
        label = "Subtract & Check Size";
        style = dashed;
        color = "#fd7e14";
        bgcolor = "#fff3cd";

        q_sub_entry -> q_sub_entry [label = "1/1, R\n#/#, R\n%/%, R\n$/$, R"];
        q_sub_entry -> q_do_sub [label = "_/_, L"];
        
        q_do_sub -> q_chk_size [label = "1/_, L"]; # Subtract here
        
        q_chk_size -> q_chk_size [label = "1/1, L"];
        q_chk_size -> q_inspect [label = "#/#, R"];
        
        q_inspect -> q_chk_1 [label = "%/%, R"];
        
        q_chk_1 -> q_reset_loop [label = "1/1, R"]; # m > 1 (Loop)
        q_chk_1 -> q_accept_clean [label = "_/_, L"]; # m <= 1 (Prime!)
        
        q_reset_loop -> q_reset_loop [label = "1/1, L\n%/%, L\n#/#, L"];
        q_reset_loop -> q_mod_entry [label = "$/$, N"];
    }

    # ==========================================
    # SECTION 6: CLEANUP (Final Phase)
    # ==========================================
    subgraph cluster_clean {
        label = "Cleanup Phase";
        style = dashed;
        color = "#343a40";
        bgcolor = "#e2e3e5";

        # Accept Cleanup
        q_accept_clean -> q_accept_clean [label = "1/1, L\n#/#, L\n%/%, L"];
        q_accept_clean -> q_seek_sep [label = "$/1, R"];
        q_seek_sep -> q_seek_sep [label = "1/1, R"];
        q_seek_sep -> q_erase_m [label = "#/_, R"];
        q_erase_m -> q_erase_m [label = "1/_, R\n%/_, R"];
        q_erase_m -> q_done_reset [label = "_/_, L"];
        q_done_reset -> q_done_reset [label = "1/1, L"];
        q_done_reset -> HALT_ACCEPT [label = "_/_, R"];

        # Reject Cleanup
        q_deny_clean -> q_wipe_left [label = "_/_, L"];
        q_wipe_left -> q_wipe_left [label = "1/_, L\n$/_, L\n#/_, L\n%/_, L"];
        q_wipe_left -> HALT_REJECT [label = "_/_, L"];
    }
}